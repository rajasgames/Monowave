{
  "name": "monowave-player",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --clean --platform android --no-install",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "jest",
    "test:ci": "jest --runInBand --ci",
    "doctor": "npx expo-doctor",
    "check:dependencies": "expo install --check",
    "check:native": "expo-modules-autolinking resolve --platform android",
    "check:native:verify": "expo-modules-autolinking verify",
    "export:android": "expo export --platform android",
    "build:apk": "npx eas-cli@latest build --platform android --profile preview",
    "build:development": "npx eas-cli@latest build --platform android --profile development",
    "build:aab": "npx eas-cli@latest build --platform android --profile production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.18",
    "expo-audio": "57.0.5",
    "expo-blur": "~57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "19.2.18",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "~29.7.0",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
